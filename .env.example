# Za lokalni dev (SQLite) ne treba ništa postaviti — samo pokreni npm run dev.
#
# Za Docker/Postgres (docker-compose.yml / docker-compose.prod.yml): kopiraj
# ovaj fajl u .env i postavi vlastite vrijednosti. .env je u .gitignore -
# nikad se ne commita.

POSTGRES_PASSWORD=promijeni-me-u-jaku-lozinku
DATABASE_URL=postgres://kompic:promijeni-me-u-jaku-lozinku@db:5432/kompic

# Samo za docker-compose.demo.yml:
POSTGRES_PASSWORD_DEMO=promijeni-me-demo

PORT=3001

# Jednostavna zaštita lozinkom - SAMO za pravu instancu (docker-compose.yml /
# docker-compose.prod.yml). Namjerno se NE koristi u docker-compose.demo.yml,
# demo ostaje bez prijave. Ostavi obje varijable prazne/izbriši ih da isključiš
# prijavu (npr. za lokalni razvoj preko "npm run dev").
#
# 1) Generiraj hash lozinke:  npm run hash-password
# 2) Zalijepi ispis ovdje:
AUTH_PASSWORD_HASH=
# Bilo koji dugi nasumični string (npr. `openssl rand -hex 32`) - koristi se
# za potpisivanje sesijskog cookieja. Ako ostane prazno, koristi se ugrađena
# zadana vrijednost (dovoljno za osobnu upotrebu, ali bolje postaviti vlastitu).
SESSION_SECRET=
# Postavi na "true" TEK kad instanca ide preko HTTPS-a (npr. Nginx/Cloudflare
# ispred). Dok je na http://localhost ili http://IP bez HTTPS-a, MORA ostati
# "false" (zadano) - inače preglednik odbija poslati cookie i prijava ne radi.
COOKIE_SECURE=false
