# Za lokalni dev (SQLite) ne treba ništa postaviti — samo pokreni npm run dev.
#
# Za Docker/Postgres (docker-compose.yml / docker-compose.prod.yml): kopiraj
# ovaj fajl u .env i postavi vlastite vrijednosti. .env je u .gitignore -
# nikad se ne commita.

POSTGRES_PASSWORD=promijeni-me-u-jaku-lozinku
DATABASE_URL=postgres://kompic:promijeni-me-u-jaku-lozinku@db:5432/kompic

# Samo za docker-compose.demo.yml:
POSTGRES_PASSWORD_DEMO=promijeni-me-demo

PORT=3001
