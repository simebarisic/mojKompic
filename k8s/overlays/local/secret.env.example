# Kopiraj u secret.env (cp secret.env.example secret.env) i postavi vrijednosti.
# secret.env je u .gitignore - nikad se ne commita.
# ./scripts/k8s-local.sh up ga automatski kreira s nasumičnim vrijednostima ako ne postoji.

# Mora biti URL-safe jer ide u DATABASE_URL -> koristi: openssl rand -hex 24
POSTGRES_PASSWORD=promijeni-me

# Prazno = bez prijave. Hash generiraj s: npm run hash-password
AUTH_PASSWORD_HASH=

# openssl rand -hex 32
SESSION_SECRET=promijeni-me
